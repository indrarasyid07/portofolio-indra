---
import AppLayout from '../layouts/AppLayout.astro'; import DataState from '../components/DataState.astro';
import { apiGetAll, errorMessage, listData, yearRange, type Experience } from '../lib/api';
const result = await apiGetAll<Experience>('experiences'); const entries = listData(result);
---
<AppLayout title="Riwayat Pekerjaan | Portofolio" description="Kronologi pekerjaan dan pengalaman profesional.">
  <div class="command-line"><span class="prompt"><span class="term-user">indra@portfolio</span><span class="term-sep">:</span><span class="term-path">~/career/</span></span><span class="term-sep">$</span> cat work-history.log</div>
  <section class="jobs-header page-block"><div><div class="eyebrow"><span>01</span> CHRONOLOGY</div><h1 class="display-title">Riwayat<br /><em>pekerjaan.</em></h1></div><div class="jobs-summary"><span class="number-display">{String(entries.length).padStart(2,'0')}</span><p>Entri pekerjaan. Diurutkan dari yang terbaru.</p></div></section>
  <section class="jobs-timeline section-rule">{entries.length ? entries.map((item,index) => <article class="job-entry"><div class="job-time"><span class="timeline-number">{String(index+1).padStart(2,'0')}</span><div>{item.start_month ? `${new Intl.DateTimeFormat('id-ID',{month:'short'}).format(new Date(2020,item.start_month-1,1))} ` : ''}{item.start_year} — {item.end_year ? `${item.end_month ? `${new Intl.DateTimeFormat('id-ID',{month:'short'}).format(new Date(2020,item.end_month-1,1))} ` : ''}${item.end_year}` : 'sekarang'}</div><small>{item.employment_type.replaceAll('_',' ')}{item.location ? ` · ${item.location}` : ''}</small></div><div class="job-content"><span class="eyebrow slim">{item.organization}</span><h2>{item.role}</h2><p>{item.summary}</p>{item.stack_labels.length > 0 && <div class="inline-chips">{item.stack_labels.map((label) => <span>{label}</span>)}</div>}{item.highlights.length > 0 && <details class="job-details" open={index === 0}><summary>Kontribusi dan cakupan pekerjaan <span class="detail-plus">+</span></summary><ul>{item.highlights.map((line) => <li>{line}</li>)}</ul></details>}</div></article>) : <DataState message={errorMessage(result.status,'riwayat pekerjaan')} retry={result.status === 'unavailable' ? '/riwayat-pekerjaan' : undefined} />}</section>
  <div class="next-path"><div class="eyebrow"><span>02</span> NEXT DIRECTORY</div><a href="/pendidikan">Pendidikan dan pembelajaran <span>→</span></a></div>
</AppLayout>
