---
import AppLayout from '../layouts/AppLayout.astro'; import DataState from '../components/DataState.astro';
import { apiGetAll, errorMessage, listData, type Experience } from '../lib/api';
const result = await apiGetAll<Experience>('experiences'); const entries = listData(result).slice(0,3);
---
<AppLayout title="Pengalaman | Portofolio" description="Pendekatan kerja dan kontribusi profesional yang telah dipublikasikan.">
  <div class="command-line"><span class="prompt"><span class="term-user">indra@portfolio</span><span class="term-sep">:</span><span class="term-path">~/work/</span></span><span class="term-sep">$</span> git log --oneline --experience</div>
  <section class="experience-intro page-block"><div><div class="eyebrow"><span>01</span> ENGINEERING PRACTICE</div><h1 class="display-title">Dari masalah<br />menjadi <em>solusi.</em></h1></div><div class="experience-intro-aside"><p>Pendekatan kerja dan kontribusi yang membentuk pengalaman profesional.</p><a href="/riwayat-pekerjaan" class="text-link">Lihat riwayat pekerjaan ↗</a></div></section>
  <section class="process-stack section-rule">{[['01','OBSERVE','Memahami konteks','Memetakan kebutuhan, kondisi pengguna, serta konsekuensi keputusan implementasi.'],['02','STRUCTURE','Membentuk solusi','Mengurai alur, mengatur dependensi, dan memastikan rancangan dapat diterapkan.'],['03','SHIP & IMPROVE','Menguji dan menyempurnakan','Memperhatikan kasus tepi, keadaan gagal, dan maintainability setelah rilis.']].map((step,index) => <article class="process-step"><span class="process-number">{step[0]}</span><div><span class="tag-mini">{step[1]}</span><h2>{step[2]}</h2><p>{step[3]}</p></div><span class="process-arrow" aria-hidden="true">{index === 2 ? '↗' : '↓'}</span></article>)}</section>
  <section class="experience-log section-rule"><div class="section-heading"><div><div class="eyebrow"><span>02</span> COMMIT HISTORY</div><h2>Catatan <em>kontribusi.</em></h2></div></div><div class="commit-list">{entries.length ? entries.map((item,index) => <article class="commit-item"><div class="commit-rail"><span class="commit-hash">{String(index+1).padStart(2,'0')}</span><span class="commit-node"></span></div><div><span class="meta-top">{item.organization} / {item.start_year}—{item.end_year ?? 'sekarang'}</span><h3>{item.role}</h3><p>{item.summary}</p>{item.stack_labels.length > 0 && <div class="inline-chips">{item.stack_labels.map((label) => <span>{label}</span>)}</div>}<ul>{item.highlights.slice(0,2).map((line) => <li>{line}</li>)}</ul></div></article>) : <DataState message={errorMessage(result.status,'pengalaman kerja')} retry={result.status === 'unavailable' ? '/pengalaman' : undefined} />}</div><a class="text-link" href="/riwayat-pekerjaan">Buka seluruh riwayat ↗</a></section>
</AppLayout>
