---
import AppLayout from '../../layouts/AppLayout.astro'; import { apiGet, type ProjectDetail } from '../../lib/api';
export const prerender = false;
const slug = Astro.params.slug ?? ''; const result = await apiGet<ProjectDetail>(`projects/${encodeURIComponent(slug)}`); if (result.status !== 'ok') Astro.response.status = result.status === 'missing' ? 404 : 503; const project = result.data;
---
{project ? <AppLayout title={`${project.title} | Proyek`} description={project.summary} image={project.cover?.url}><article>
  <div class="command-line"><span class="prompt"><span class="term-user">indra@portfolio</span><span class="term-sep">:</span><span class="term-path">~/projects/{project.slug}/</span></span><span class="term-sep">$</span> cat case-study.md</div>
  <div class="detail-return"><a href="/proyek">← Semua proyek</a><span>CASE STUDY / {project.year}</span></div>
  <section class="detail-header page-block"><div class="eyebrow"><span>01</span> {project.project_type.toUpperCase()}</div><h1 class="display-title">{project.title}<em>.</em></h1><p class="lede">{project.subtitle ?? project.summary}</p><div class="detail-header-meta"><div><small>TAHUN</small>{project.year}</div><div><small>PERAN</small>{project.role}</div><div><small>TEKNOLOGI</small>{project.stack_labels.join(', ') || 'Belum dicantumkan'}</div></div></section>
  <section class="detail-gallery section-rule"><div class="gallery-chrome"><span>MEDIA VIEWER / {project.images.length} FILE(S)</span><span>SCREENSHOT</span></div><div class="gallery-main">{project.cover?.url ? <img class="gallery-active-image" src={project.cover.url} alt={project.cover.alt_text} /> : <div class="gallery-empty">Screenshot proyek belum tersedia.</div>}</div>{project.images.length > 0 && <div class="gallery-thumbs" role="group" aria-label="Pilih screenshot">{project.images.map((image,index) => image.url && <button class:list={['thumb-btn', index === 0 && 'is-selected']} type="button" aria-label={`Tampilkan screenshot ${index+1}`} aria-pressed={index === 0} data-img={image.url} data-alt={image.alt_text}><img src={image.url} alt="" loading="lazy" /><span>{String(index+1).padStart(2,'0')}</span></button>)}</div>}</section>
  <section class="detail-story section-rule"><div><div class="eyebrow"><span>02</span> CASE NOTES</div><h2>Dari konteks<br />ke <em>implementasi.</em></h2></div><div class="case-entries"><article><span>01 / MASALAH</span><h3>Apa yang perlu diselesaikan?</h3><p>{project.challenge ?? 'Belum dicantumkan.'}</p></article><article><span>02 / PENDEKATAN</span><h3>Bagaimana solusinya dibangun?</h3><p>{project.solution ?? 'Belum dicantumkan.'}</p></article><article><span>03 / HASIL</span><h3>Apa yang dihasilkan?</h3><p>{project.outcome ?? 'Belum dicantumkan.'}</p></article>{project.related_experiences.length > 0 && <article><span>04 / KONTEKS KARIER</span><h3>Dikerjakan dalam</h3><ul>{project.related_experiences.map((item) => <li>{item.role} · {item.organization}</li>)}</ul></article>}<div class="inline-actions">{project.demo_url && <a class="btn btn-outline" href={project.demo_url} rel="noreferrer">Buka demo ↗</a>}{project.repository_url && <a class="btn btn-outline" href={project.repository_url} rel="noreferrer">Lihat repository ↗</a>}</div></div></section>
  <div class="next-path"><span>END OF CASE STUDY</span><a href="/proyek">Kembali ke project library <span>→</span></a></div>
</article></AppLayout> : <AppLayout title={result.status === 'missing' ? 'Proyek tidak ditemukan | Portofolio' : 'Proyek tidak tersedia | Portofolio'} description="Detail proyek tidak tersedia." noindex omitCanonical><div class="command-line">$ cat projects/{slug}/README.md</div><section class="page-block"><h1 class="display-title">{result.status === 'missing' ? <>Proyek ini<br /><em>tidak tersedia.</em></> : <>Detail belum<br /><em>dapat dimuat.</em></>}</h1><p class="lede">{result.status === 'missing' ? 'Proyek tidak ditemukan atau belum dipublikasikan.' : 'Silakan coba lagi nanti.'}</p><a class="text-link" href="/proyek">Kembali ke daftar proyek ↗</a></section></AppLayout>}
<script src="../../scripts/project-gallery.ts"></script>
