---
import AppLayout from '../../layouts/AppLayout.astro'; import DataState from '../../components/DataState.astro';
import { apiGetAll, errorMessage, listData, type Project } from '../../lib/api';
const result = await apiGetAll<Project>('projects'); const projects = listData(result); const featured = projects.find((item) => item.featured) ?? projects[0]; const types = [...new Set(projects.map((item) => item.project_type))];
---
<AppLayout title="Proyek | Portofolio" description="Kumpulan proyek dan studi kasus yang telah dipublikasikan.">
  <div class="command-line"><span class="prompt"><span class="term-user">indra@portfolio</span><span class="term-sep">:</span><span class="term-path">~/</span></span><span class="term-sep">$</span> ls -lh projects/</div>
  <section class="projects-head page-block"><div><div class="eyebrow"><span>01</span> WORK INDEX</div><h1 class="display-title">Proyek &<br /><em>eksperimen.</em></h1><p class="lede">Studi kasus mencakup konteks, kontribusi, teknologi, dan dokumentasi visual yang tersedia.</p></div><div class="projects-counter"><span>{String(projects.length).padStart(2,'0')}</span>PROJECT ENTRIES</div></section>
  {featured && <section class="project-spotlight section-rule"><a class="spotlight-visual" href={`/proyek/${featured.slug}`}>{featured.cover?.url ? <img src={featured.cover.url} alt={featured.cover.alt_text} loading="lazy" /> : <div class="gallery-empty">Screenshot belum tersedia</div>}<span class="visual-corner">SELECTED PROJECT <b>↗</b></span></a><div class="spotlight-copy"><div class="eyebrow"><span>02</span> FEATURED CASE</div><span class="spotlight-year">{featured.year} / {featured.project_type}</span><h2>{featured.title}</h2><p>{featured.summary}</p><div class="spotlight-dl"><div><small>PERAN</small><strong>{featured.role}</strong></div><div><small>STACK</small><strong>{featured.stack_labels.length ? featured.stack_labels.join(' · ') : 'Belum dicantumkan'}</strong></div></div><a href={`/proyek/${featured.slug}`} class="btn btn-primary">Buka studi kasus ↗</a></div></section>}
  <section class="project-index section-rule"><div class="section-heading"><div><div class="eyebrow"><span>03</span> ALL PROJECTS</div><h2>Project <em>library.</em></h2></div><span class="meta-top">SCREENSHOT + CONTEXT + STACK</span></div>
    {projects.length ? <><div class="filter-bar" role="group" aria-label="Filter tipe proyek"><button type="button" class="filter-btn is-active" data-filter="all" aria-pressed="true">Semua <sup>{projects.length}</sup></button>{types.map((type) => <button type="button" class="filter-btn" data-filter={type.toLowerCase()} aria-pressed="false">{type} <sup>{projects.filter((project) => project.project_type === type).length}</sup></button>)}</div><div class="project-grid" id="project-grid">{projects.map((item,index) => <article class="project-tile" data-type={item.project_type.toLowerCase()}><a class="project-image" href={`/proyek/${item.slug}`}>{item.cover?.url ? <img src={item.cover.url} alt={item.cover.alt_text} loading="lazy" /> : <div class="gallery-empty">Preview belum tersedia</div>}<span class="project-image-top">{item.project_type.toUpperCase()} / {item.year}</span></a><div class="project-tile-copy"><span class="muted-index">{String(index+1).padStart(2,'0')} / {item.role}</span><h3><a href={`/proyek/${item.slug}`}>{item.title} <span>↗</span></a></h3><p>{item.summary}</p><div class="inline-chips">{item.stack_labels.slice(0,4).map((tag) => <span>{tag}</span>)}</div></div></article>)}</div><p id="filter-empty" class="empty-message" hidden>Tidak ada proyek dalam kategori ini.</p></> : <DataState message={errorMessage(result.status,'proyek')} retry={result.status === 'unavailable' ? '/proyek' : undefined} />}
  </section>
</AppLayout>
<script src="../../scripts/project-filters.ts"></script>
