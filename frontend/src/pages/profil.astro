---
import AppLayout from '../layouts/AppLayout.astro'; import DataState from '../components/DataState.astro';
import { apiGet, errorMessage, type Profile } from '../lib/api';
const result = await apiGet<Profile>('profile'); const profile = result.data;
---
<AppLayout title={profile ? `Profil ${profile.name} | Portofolio` : 'Profil | Portofolio'} description={profile?.intro ?? 'Profil dan latar belakang programmer.'} image={profile?.portrait?.url}>
  <div class="command-line"><span class="prompt"><span class="term-user">indra@portfolio</span><span class="term-sep">:</span><span class="term-path">~/profile/</span></span><span class="term-sep">$</span> cat about.md</div>
  {profile ? <><section class="profile-heading page-block"><div class="eyebrow"><span>01</span> PROFIL / README.md</div><div class="profile-heading-grid"><div class="profile-heading-copy"><h1 class="display-title profile-name-title">{profile.name}<span class="accent-dot">.</span></h1><p class="profile-role">{profile.role}</p><p class="profile-headline">{profile.headline}</p><p class="profile-summary">{profile.intro}</p></div><span class="huge-outline" aria-hidden="true">IR/</span></div></section>
  <section class="profile-editorial section-rule"><aside><div class="portrait-frame">{profile.portrait?.url ? <img src={profile.portrait.url} alt={profile.portrait.alt_text} loading="lazy" /> : <div class="gallery-empty">Foto profil belum tersedia</div>}</div>{profile.portrait?.caption && <p class="mono-caption">{profile.portrait.caption}</p>}<div class="profile-facts">{profile.location && <div><small>LOKASI</small><strong>{profile.location}</strong></div>}{profile.availability && <div><small>KETERSEDIAAN</small><strong>{profile.availability}</strong></div>}</div></aside>
  <article class="profile-story"><div class="eyebrow"><span>02</span> TENTANG SAYA</div><h2>Perjalanan profesional.</h2><p class="story-lead">{profile.about || 'Perjalanan profesional belum ditambahkan.'}</p><div class="inline-actions"><a class="btn btn-outline" href="/riwayat-pekerjaan">Lihat riwayat pekerjaan ↗</a>{profile.cv_url && <a class="text-link" href={profile.cv_url} rel="noreferrer">Unduh CV ↗</a>}</div></article></section></> : <div class="page-block"><DataState message={errorMessage(result.status,'profil publik')} retry={result.status === 'unavailable' ? '/profil' : undefined} /></div>}
</AppLayout>
