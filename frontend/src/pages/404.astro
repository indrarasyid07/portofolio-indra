---
import AppLayout from '../layouts/AppLayout.astro';
Astro.response.status = 404;
---
<AppLayout title="Halaman tidak ditemukan | Portofolio" description="Halaman yang dicari tidak tersedia." noindex>
  <section class="page-shell not-found" aria-labelledby="page-title"><div class="route-label"><span class="route-prompt">$</span> cd {Astro.url.pathname}</div><p class="eyebrow">404 / jalur tidak ditemukan</p><h1 id="page-title">Halaman ini<br /><em>belum ada.</em></h1><a class="home-link" href="/">Kembali ke beranda <span aria-hidden="true">↗</span></a></section>
</AppLayout>
