---
import AppLayout from '../layouts/AppLayout.astro'; import { apiGet, type Contact } from '../lib/api';
const result = await apiGet<Contact>('contact'); const contact = result.data;
---
<AppLayout title="Kontak | Portofolio" description="Kanal kontak publik untuk peluang kerja dan kolaborasi.">
  <div class="command-line"><span class="prompt"><span class="term-user">indra@portfolio</span><span class="term-sep">:</span><span class="term-path">~/</span></span><span class="term-sep">$</span> ./connect.sh</div>
  <section class="contact-head page-block"><div class="eyebrow"><span>01</span> ESTABLISH CONNECTION</div><h1 class="display-title">Punya sesuatu<br />untuk <em>dibicarakan?</em></h1><p class="lede">Peluang kerja, kebutuhan pengembangan, atau kolaborasi — kirim konteks singkat untuk memulai percakapan.</p></section>
  <section class="contact-layout section-rule"><div class="contact-info"><span class="code-comment">$ echo $CONTACT</span><h2>Mulai dari sini.</h2><p>Ceritakan tujuan atau konteks yang ingin dibahas. Pesan akan disiapkan melalui aplikasi email Anda.</p><div class="contact-addresses"><div><small>EMAIL</small>{contact?.email ? <a href={`mailto:${contact.email}`}>{contact.email} ↗</a> : <span>Belum dikonfigurasi</span>}</div><div><small>GITHUB</small>{contact?.github ? <a href={contact.github} rel="noreferrer">GitHub ↗</a> : <span>Belum dikonfigurasi</span>}</div><div><small>LINKEDIN</small>{contact?.linkedin ? <a href={contact.linkedin} rel="noreferrer">LinkedIn ↗</a> : <span>Belum dikonfigurasi</span>}</div></div><p class="security-line">// Form membuka aplikasi email; situs tidak menyimpan pesan.</p></div>
    <form class="contact-form" id="contact-form" data-recipient={contact?.email ?? ''}><div class="form-top"><span>NEW MESSAGE</span><span>UTF-8 / PLAIN TEXT</span></div><h2>Tulis pesan<span class="accent-dot">_</span></h2><label for="contact-name">Nama <span>*</span></label><input id="contact-name" name="name" autocomplete="name" required maxlength="120" placeholder="Nama Anda" /><label for="contact-email">Email <span>*</span></label><input id="contact-email" type="email" name="email" autocomplete="email" required maxlength="254" placeholder="nama@domain.com" /><label for="contact-message">Pesan <span>*</span></label><textarea id="contact-message" name="message" rows="6" required maxlength="5000" placeholder="Ceritakan singkat kebutuhan dan konteksnya..."></textarea><p class="form-message" id="form-message" role="status" aria-live="polite"></p><button type="submit" class="btn btn-primary" disabled={!contact?.email}>Siapkan email ↗</button>{!contact?.email && <p class="security-line">Alamat penerima belum diatur. Gunakan kanal publik setelah email ditambahkan.</p>}</form>
  </section>
</AppLayout>
<script>
  const form = document.querySelector<HTMLFormElement>('#contact-form'); const message = document.querySelector<HTMLElement>('#form-message');
  form?.addEventListener('submit', (event) => { event.preventDefault(); if (!form.reportValidity() || !message) return; const recipient = form.dataset.recipient; if (!recipient) { message.textContent = 'Alamat penerima belum dikonfigurasi.'; return; } const data = new FormData(form); const name = String(data.get('name') ?? '').trim(); const email = String(data.get('email') ?? '').trim(); const body = `${String(data.get('message') ?? '').trim()}\n\n—\n${name}\n${email}`; message.textContent = 'Aplikasi email akan terbuka. Pesan belum dikirim.'; window.location.href = `mailto:${recipient}?subject=${encodeURIComponent(`Pesan portofolio dari ${name}`)}&body=${encodeURIComponent(body)}`; });
</script>
