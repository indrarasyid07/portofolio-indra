---
import AuthLayout from '../../layouts/AuthLayout.astro';

function safeReturnTo(value: string | null): string {
  if (!value || !/^\/admin(?:\/[A-Za-z0-9._~-]+)*\/?$/.test(value)) return '/admin';
  if (value.split('/').some((segment) => segment === '.' || segment === '..')) return '/admin';
  return value;
}

const returnTo = safeReturnTo(Astro.url.searchParams.get('returnTo'));
const expired = Astro.url.searchParams.get('expired') === '1';
---
<AuthLayout title="Login Admin | Portofolio" description="Login ke ruang pengelolaan portofolio.">
  <main class="auth-page" id="main-content" data-return-to={returnTo}>
    <section class="auth-aside"><a class="logo" href="/"><span class="logo-glyph">~/</span> indra.rasyid <span class="auth-path">/admin</span></a><div><span class="eyebrow"><span>ACCESS CONTROL</span> / ROOT</span><div class="big-auth-symbol" aria-hidden="true">$ _</div><h1>Private<br /><em>workspace.</em></h1><p>Kelola profil, pengalaman kerja, proyek, media, pendidikan, dan tech stack dari panel admin.</p></div><span class="auth-aside-bottom">AUTHENTICATED SESSION / PRIVATE</span></section>
    <section class="auth-main"><div class="auth-box"><span class="auth-mini">$ sudo login --admin</span><h2 id="login-title">Masuk panel.</h2>
    <p>Gunakan akun administrator untuk melanjutkan.</p>
    {expired && <p class="login-notice" role="status">Sesi telah berakhir. Silakan masuk kembali; perubahan yang belum dikirim tidak tersimpan.</p>}
    <form class="auth-form login-form" id="login-form">
      <label for="username">Nama pengguna</label>
      <input id="username" name="username" autocomplete="username" required minlength="3" maxlength="80" pattern="[A-Za-z0-9._-]+" autocapitalize="none" spellcheck="false" />
      <label for="password">Kata sandi</label>
      <input id="password" name="password" type="password" autocomplete="current-password" required minlength="8" maxlength="128" />
      <p class="form-message" id="login-status" role="status" aria-live="polite"></p>
      <button class="btn btn-primary" type="submit"><span>Masuk ke workspace ↗</span></button>
    </form>
    <a href="/" class="auth-return">← Kembali ke portofolio</a></div></section>
  </main>
  <script src="../../scripts/admin-login.ts"></script>
</AuthLayout>
