---
import AppLayout from '../layouts/AppLayout.astro'; import DataState from '../components/DataState.astro';
import { apiGetAll, errorMessage, listData, yearRange, type Education } from '../lib/api';
const result = await apiGetAll<Education>('education'); const records = listData(result);
const formal = records.filter((item) => item.kind === 'formal'); const informal = records.filter((item) => item.kind !== 'formal');
---
<AppLayout title="Pendidikan & Sertifikasi | Portofolio" description="Pendidikan, kursus, dan sertifikasi yang dipublikasikan.">
  <div class="command-line"><span class="prompt"><span class="term-user">indra@portfolio</span><span class="term-sep">:</span><span class="term-path">~/</span></span><span class="term-sep">$</span> tree learning/</div>
  <section class="education-header page-block"><div><div class="eyebrow"><span>01</span> LEARNING DIRECTORY</div><h1 class="display-title">Belajar itu<br /><em>proses panjang.</em></h1><p class="lede">Pendidikan formal, kursus, dan sertifikasi yang relevan dengan perjalanan profesional.</p></div><div class="ascii-tree" aria-hidden="true"><span class="tree-root">learning/</span><br />├── formal/<br />│&nbsp;&nbsp; └── education.md<br />└── certifications/<br />&nbsp;&nbsp;&nbsp; ├── courses.json<br />&nbsp;&nbsp;&nbsp; └── notes.txt<span class="ascii-cursor">_</span></div></section>
  <section class="education-layout section-rule"><aside class="education-directory"><div class="directory-title">EXPLORER <span>⌄</span></div><a href="#formal">▸ <span>formal/</span><small>{formal.length}</small></a><a href="#nonformal">▸ <span>certifications/</span><small>{informal.length}</small></a><div class="directory-hint">$ find learning/ -type f</div></aside><div class="education-entries"><div id="formal" class="education-subhead"><span>01 / FORMAL</span><h2>Pendidikan</h2></div>{formal.length ? formal.map((item,index) => <article class="edu-record"><div class="edu-year">{yearRange(item.start_year,item.end_year)}</div><div><h3>{item.title}</h3><p class="edu-org">{item.institution}</p>{item.description && <p>{item.description}</p>}{item.credential_id && <p class="mono-caption">ID kredensial: {item.credential_id}</p>}{item.proof_url && <a class="text-link" href={item.proof_url} rel="noreferrer">Lihat bukti ↗</a>}</div><span class="edu-index">{String(index+1).padStart(2,'0')}</span></article>) : <p class="empty-message">Belum ada pendidikan formal yang dipublikasikan.</p>}<div id="nonformal" class="education-subhead second"><span>02 / NONFORMAL</span><h2>Kursus & sertifikasi</h2></div>{informal.length ? informal.map((item,index) => <article class="edu-record"><div class="edu-year">{yearRange(item.start_year,item.end_year)}</div><div><h3>{item.title}</h3><p class="edu-org">{item.institution}</p>{item.description && <p>{item.description}</p>}{item.credential_id && <p class="mono-caption">ID kredensial: {item.credential_id}</p>}{item.proof_url && <a class="text-link" href={item.proof_url} rel="noreferrer">Lihat bukti ↗</a>}</div><span class="edu-index">{String(index+1).padStart(2,'0')}</span></article>) : <p class="empty-message">Belum ada kursus atau sertifikasi yang dipublikasikan.</p>}{result.status === 'unavailable' && <DataState message={errorMessage(result.status,'riwayat pendidikan')} retry="/pendidikan" />}</div></section>
</AppLayout>
