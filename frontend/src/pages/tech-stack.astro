---
import AppLayout from '../layouts/AppLayout.astro'; import DataState from '../components/DataState.astro';
import { apiGet, errorMessage, listData, type SkillCategory } from '../lib/api';
const result = await apiGet<SkillCategory[]>('skills'); const categories = listData(result);
---
<AppLayout title="Tech Stack | Portofolio" description="Teknologi dan tools yang digunakan secara umum.">
  <div class="command-line"><span class="prompt"><span class="term-user">indra@portfolio</span><span class="term-sep">:</span><span class="term-path">~/</span></span><span class="term-sep">$</span> cat tech-stack.yml</div>
  <section class="tech-header page-block"><div><div class="eyebrow"><span>01</span> TOOLS & CAPABILITIES</div><h1 class="display-title">Tools di balik<br /><em>pekerjaan.</em></h1></div><div class="tech-annotation"><span class="code-comment"># ecosystem, not trophies</span><p>Teknologi dikelompokkan berdasarkan kegunaan. Stack tiap proyek tercatat pada studi kasusnya.</p></div></section>
  <section class="tech-layout section-rule"><div class="tech-left"><span class="file-label">~/config/tech-stack.yml</span><div class="tech-code"><span class="code-line"><b>01</b><span class="code-key">skills</span>:</span><span class="code-line"><b>02</b>&nbsp;&nbsp;categories: <em>{categories.length}</em></span><span class="code-line"><b>03</b>&nbsp;&nbsp;entries: <em>{categories.reduce((total,category) => total + category.skills.length,0)}</em></span><span class="code-line"><b>04</b>&nbsp;&nbsp;scope: <em>public</em></span><span class="code-line"><b>05</b>&nbsp;&nbsp;source: <em>admin_panel</em></span></div><p class="mono-caption">// data yang dipublikasikan dari admin</p></div><div class="tech-matrix">{categories.length ? categories.map((category,index) => <section class="tech-category"><div class="tech-category-head"><span>{String(index+1).padStart(2,'0')} / {category.label.toUpperCase()}</span><span>{String(category.skills.length).padStart(2,'0')} ITEMS</span></div><div class="tech-pills">{category.skills.map((skill) => <div class="tech-pill">{skill.image?.url && <img src={skill.image.url} alt={skill.image.alt_text} loading="lazy" width="24" height="24" />}<b>{skill.name}</b>{skill.note && <small>{skill.note}</small>}</div>)}</div></section>) : <DataState message={errorMessage(result.status,'tech stack')} retry={result.status === 'unavailable' ? '/tech-stack' : undefined} />}</div></section>
</AppLayout>
